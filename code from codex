<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>plastikfruits</title>
  <link rel="icon" href="./monterey-base/public/app-icons/finder/32.png">
  <style>
    :root {
      --system-color-primary: hsl(211, 100%, 50%);
      --system-color-primary-hsl: 211, 100%, 50%;
      --system-color-primary-contrast: #fff;
      --system-color-light-hsl: 240, 24%, 100%;
      --system-color-dark-hsl: 0, 0%, 11%;
      --system-font-family: -apple-system, BlinkMacSystemFont, "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
      --system-cursor-default: url("./monterey-base/public/cursors/normal-select.svg");
      --system-cursor-pointer: url("./monterey-base/public/cursors/link-select.svg");
      --window-shadow: 0 8.5px 10px rgba(0, 0, 0, 0.28), 0 68px 80px rgba(0, 0, 0, 0.56);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      cursor: var(--system-cursor-default), auto;
      -webkit-font-smoothing: antialiased;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: var(--system-font-family);
      user-select: none;
    }

    body {
      background: #111;
      color: #1d1d1f;
    }

    button {
      appearance: none;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      cursor: var(--system-cursor-default), auto;
    }

    button:focus {
      outline: none;
    }

    #desktop {
      position: relative;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: url("./monterey-base/src/assets/wallpapers/ventura-2.webp") center / cover no-repeat;
    }

    #topbar {
      position: relative;
      z-index: 90;
      height: 1.8rem;
      display: flex;
      align-items: center;
      color: #fff;
      background: hsla(var(--system-color-light-hsl), 0.3);
      text-shadow: 0 0 1px rgba(0, 0, 0, 0.18);
    }

    #topbar::before {
      content: "";
      position: fixed;
      inset: 0 0 auto 0;
      height: 1.8rem;
      backdrop-filter: blur(12px);
      z-index: -1;
    }

    .menu {
      height: 100%;
      display: flex;
      align-items: center;
    }

    .menu button,
    .status button {
      height: 100%;
      padding: 0 0.55rem;
      border-radius: 0.25rem;
      font-size: 0.82rem;
      font-weight: 500;
      letter-spacing: 0.01em;
    }

    .menu button:hover,
    .status button:hover {
      background-color: hsla(var(--system-color-dark-hsl), 0.2);
    }

    #menubar-menu {
      position: fixed;
      top: 1.85rem;
      left: 0;
      z-index: 160;
      min-width: 15rem;
      display: none;
      padding: 0.45rem;
      border-radius: 0.55rem;
      background: hsla(var(--system-color-light-hsl), 0.48);
      color: #1d1d1f;
      box-shadow: rgba(0, 0, 0, 0.28) 0 0 12px;
      backdrop-filter: blur(18px);
    }

    #menubar-menu.open {
      display: block;
    }

    #menubar-menu button {
      width: 100%;
      min-height: 1.65rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.25rem 0.45rem;
      border-radius: 0.34rem;
      font-size: 0.86rem;
      text-align: left;
    }

    #menubar-menu button:hover {
      background: var(--system-color-primary);
      color: white;
    }

    #menubar-menu button[disabled] {
      color: rgba(29, 29, 31, 0.35);
    }

    #menubar-menu button[disabled]:hover {
      background: transparent;
      color: rgba(29, 29, 31, 0.35);
    }

    #menubar-menu kbd {
      margin-left: 2rem;
      color: currentColor;
      opacity: 0.62;
      font: inherit;
    }

    .apple {
      display: grid;
      place-items: center;
      margin-left: 0.5rem;
    }

    .apple svg {
      width: 1rem;
      height: 1rem;
      fill: currentColor;
    }

    .menu .app-name {
      margin: 0 0.4rem;
      font-weight: 700;
    }

    .spacer {
      flex: 1;
    }

    .status {
      height: 100%;
      display: flex;
      align-items: center;
      padding-right: 0.55rem;
    }

    #icons {
      position: absolute;
      inset: 1.8rem 0 5.25rem;
      z-index: 1;
    }

    .desktop-icon {
      position: absolute;
      width: 6.4rem;
      min-height: 6.3rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem;
      color: #fff;
      text-align: center;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.72);
      border-radius: 0.45rem;
    }

    .desktop-icon:hover .label {
      background: hsla(var(--system-color-primary-hsl), 0.35);
    }

    .desktop-icon.selected .label {
      background: var(--system-color-primary);
      text-shadow: none;
    }

    .label {
      max-width: 5.7rem;
      padding: 0.12rem 0.28rem;
      border-radius: 0.25rem;
      font-size: 0.78rem;
      font-weight: 500;
      line-height: 1.15;
      overflow-wrap: anywhere;
      white-space: normal;
    }

    .icon {
      width: 4rem;
      height: 4rem;
      position: relative;
      display: block;
      filter: drop-shadow(0 0.18rem 0.2rem rgba(0, 0, 0, 0.34));
    }

    .icon.finder {
      background: url("./monterey-base/public/app-icons/finder/256.png") center / contain no-repeat;
    }

    .icon.drive {
      width: 3.85rem;
      height: 3.65rem;
      border-radius: 0.55rem;
      background: linear-gradient(120deg, rgba(255,255,255,.72) 0 22%, transparent 22%),
        linear-gradient(#fafafa, #d6d6d8 50%, #96979c);
      box-shadow: inset 0 0 0 1px rgba(65,65,70,.35), inset 0 2px 0 rgba(255,255,255,.9);
    }

    .icon.drive::before {
      content: "";
      position: absolute;
      top: 0.72rem;
      left: 0.72rem;
      right: 0.72rem;
      height: 1.05rem;
      border: 0.12rem solid #777;
      border-radius: 50%;
      background: linear-gradient(#c7c7c8, #f5f5f5);
    }

    .icon.drive::after {
      content: "";
      position: absolute;
      left: 0.72rem;
      right: 0.72rem;
      bottom: 0.62rem;
      height: 0.42rem;
      border-radius: 0.14rem;
      background: #777;
      box-shadow: 1.72rem 0 0 -0.12rem #70cf61;
    }

    .icon.folder,
    .icon.gateway {
      height: 3.25rem;
      margin-top: 0.5rem;
    }

    .icon.folder::before,
    .icon.gateway::before {
      content: "";
      position: absolute;
      top: 0.1rem;
      left: 0.25rem;
      width: 1.9rem;
      height: 0.72rem;
      border-radius: 0.24rem 0.24rem 0 0;
      background: linear-gradient(#9fd7ff, #62aee6);
      box-shadow: inset 0 0 0 1px rgba(31, 98, 148, 0.5);
    }

    .icon.folder::after,
    .icon.gateway::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 4rem;
      height: 2.82rem;
      border-radius: 0.22rem 0.42rem 0.42rem 0.42rem;
      background: linear-gradient(rgba(255,255,255,.58), rgba(255,255,255,.08) 42%, transparent),
        linear-gradient(#73c4fb, #3c8fd4 58%, #2875b8);
      box-shadow: inset 0 0 0 1px rgba(25,88,139,.55), inset 0 1px 0 rgba(255,255,255,.55);
    }

    .icon.gateway::before {
      background: linear-gradient(#cbd7dc, #8ba3ad);
      box-shadow: inset 0 0 0 1px rgba(74,100,111,.55);
    }

    .icon.gateway::after {
      background: linear-gradient(rgba(255,255,255,.45), rgba(255,255,255,.08) 42%, transparent),
        linear-gradient(#b4c3ca, #77919d 60%, #5d7885);
      box-shadow: inset 0 0 0 1px rgba(72,98,108,.65), inset 0 1px 0 rgba(255,255,255,.45);
    }

    .icon.document {
      width: 3.15rem;
      height: 4rem;
      border-radius: 0.16rem 0.75rem 0.16rem 0.16rem;
      background: #fffef2;
      box-shadow: inset 0 0 0 1px rgba(0,0,0,.18), 0 0.12rem 0.24rem rgba(0,0,0,.22);
    }

    .icon.document::before {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      width: 0.85rem;
      height: 0.85rem;
      border-left: 1px solid rgba(0,0,0,.16);
      border-bottom: 1px solid rgba(0,0,0,.16);
      border-radius: 0 0.7rem 0 0;
      background: #e5e5dc;
    }

    .icon.document::after {
      content: "";
      position: absolute;
      top: 1.45rem;
      left: 0.68rem;
      width: 1.8rem;
      height: 0.13rem;
      border-radius: 1rem;
      background: #b8b8ae;
      box-shadow: 0 .45rem 0 #d7d7cc, 0 .9rem 0 #c3c3b9, 0 1.35rem 0 #d7d7cc;
    }

    .icon.trash {
      width: 3.7rem;
      height: 4rem;
      border: 0.12rem solid rgba(255,255,255,.9);
      border-radius: 0.38rem 0.38rem 0.78rem 0.78rem;
      background: repeating-linear-gradient(90deg, rgba(255,255,255,.44) 0 .25rem, rgba(200,214,221,.5) .25rem .52rem),
        rgba(215,228,234,.58);
    }

    .icon.trash::before {
      content: "";
      position: absolute;
      top: -0.56rem;
      left: 0.52rem;
      width: 2.5rem;
      height: 0.44rem;
      border-radius: 0.18rem;
      background: rgba(255,255,255,.9);
    }

    .icon.image-icon {
      background-position: center;
      background-size: contain;
      background-repeat: no-repeat;
    }

    .icon.image-icon::before,
    .icon.image-icon::after {
      display: none;
    }

    .window {
      position: absolute;
      z-index: 10;
      display: grid;
      grid-template-rows: 3.25rem 2.65rem 1fr 1.6rem;
      overflow: hidden;
      width: min(980px, calc(100vw - 3rem));
      height: min(680px, calc(100vh - 7.4rem));
      left: max(1.5rem, calc(50vw - 490px));
      top: 4.2rem;
      border-radius: 0.75rem;
      background: #fff;
      box-shadow: var(--window-shadow);
      transition:
        width 180ms ease,
        height 180ms ease,
        left 180ms ease,
        top 180ms ease;
    }

    .window.hidden {
      display: none;
    }

    .window.maximized {
      left: 0.6rem !important;
      top: 2.45rem !important;
      width: calc(100vw - 1.2rem) !important;
      height: calc(100vh - 3rem) !important;
    }

    .titlebar {
      position: relative;
      display: grid;
      place-items: center;
      background: hsla(var(--system-color-light-hsl), 0.78);
      border-bottom: 0.5px solid hsla(var(--system-color-dark-hsl), 0.16);
      backdrop-filter: blur(20px);
    }

    .titlebar h1 {
      font-size: 0.92rem;
      font-weight: 650;
    }

    .traffic {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      display: grid;
      grid-template-columns: repeat(3, 0.8rem);
      gap: 0.6rem;
      align-items: center;
    }

    .light {
      width: 0.8rem;
      height: 0.8rem;
      display: grid;
      place-items: center;
      border-radius: 50%;
      box-shadow: 0 0 0 0.5px var(--border);
      background: var(--bg);
    }

    .light svg {
      width: 0.45rem;
      height: 0.45rem;
      opacity: 0;
    }

    .traffic:hover .light svg {
      opacity: 1;
    }

    .light:hover {
      transform: scale(1.2);
    }

    .red { --bg: #ff5f56; --border: #e0443e; }
    .yellow { --bg: #ffbd2e; --border: #dea123; }
    .green { --bg: #27c93f; --border: #1aab29; }

    .toolbar {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0 0.85rem;
      border-bottom: 0.5px solid hsla(var(--system-color-dark-hsl), 0.13);
      background: hsla(var(--system-color-light-hsl), 0.64);
      backdrop-filter: blur(18px);
    }

    .toolbar button {
      width: 1.85rem;
      height: 1.55rem;
      border-radius: 0.42rem;
      background: hsla(var(--system-color-dark-hsl), 0.08);
      color: hsla(var(--system-color-dark-hsl), 0.78);
      font-size: 1rem;
      font-weight: 650;
    }

    .toolbar p {
      margin-left: auto;
      color: hsla(var(--system-color-dark-hsl), 0.56);
      font-size: 0.82rem;
    }

    .finder-main {
      min-height: 0;
      display: grid;
      grid-template-columns: 13.5rem 1fr;
    }

    aside {
      overflow-y: auto;
      padding: 1rem 0.75rem;
      border-right: 0.5px solid hsla(var(--system-color-dark-hsl), 0.16);
      background: hsla(0, 0%, 88%, 0.55);
      backdrop-filter: blur(24px);
    }

    .sidebar-section {
      margin-bottom: 1rem;
    }

    .sidebar-section h2 {
      margin: 0 0 0.34rem 0.45rem;
      color: hsla(var(--system-color-dark-hsl), 0.52);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .sidebar-section button {
      width: 100%;
      min-height: 1.75rem;
      display: flex;
      justify-content: flex-start;
      align-items: center;
      gap: 0.5rem;
      padding: 0.28rem 0.55rem;
      border-radius: 0.42rem;
      color: hsla(var(--system-color-dark-hsl), 0.82);
      font-size: 0.86rem;
      text-align: left;
    }

    .sidebar-section button:hover {
      background: hsla(var(--system-color-dark-hsl), 0.07);
    }

    .sidebar-section button.active {
      background: var(--system-color-primary);
      color: var(--system-color-primary-contrast);
    }

    .sidebar-folder {
      width: 1rem;
      height: 0.78rem;
      position: relative;
      flex: 0 0 auto;
      border-radius: 0.12rem 0.18rem 0.18rem 0.18rem;
      background: currentColor;
      opacity: 0.6;
    }

    .sidebar-folder::before {
      content: "";
      position: absolute;
      top: -0.22rem;
      left: 0;
      width: 0.48rem;
      height: 0.24rem;
      border-radius: 0.12rem 0.12rem 0 0;
      background: currentColor;
    }

    #filearea {
      min-width: 0;
      overflow: auto;
      padding: 2rem;
      background: hsla(var(--system-color-light-hsl), 0.96);
    }

    .file-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(6.4rem, 1fr));
      gap: 1.45rem 1.2rem;
    }

    .file-item {
      min-height: 6.4rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.45rem;
      padding: 0.45rem 0.3rem;
      border-radius: 0.5rem;
      color: hsla(var(--system-color-dark-hsl), 0.9);
      text-align: center;
    }

    .file-item:hover {
      background: hsla(var(--system-color-primary-hsl), 0.14);
    }

    .file-label {
      max-width: 5.8rem;
      white-space: pre-line;
      font-size: 0.84rem;
      line-height: 1.18;
      overflow-wrap: anywhere;
    }

    .file-icon {
      width: 4rem;
      height: 3.25rem;
      position: relative;
      display: block;
      filter: drop-shadow(0 .12rem .16rem rgba(0,0,0,.22));
    }

    .file-icon.folder::before,
    .file-icon.folder::after {
      content: "";
      position: absolute;
    }

    .file-icon.folder::before {
      top: .1rem;
      left: .25rem;
      width: 1.9rem;
      height: .72rem;
      border-radius: .24rem .24rem 0 0;
      background: linear-gradient(#9fd7ff, #62aee6);
      box-shadow: inset 0 0 0 1px rgba(31,98,148,.48);
    }

    .file-icon.folder::after {
      left: 0;
      bottom: 0;
      width: 4rem;
      height: 2.82rem;
      border-radius: .22rem .42rem .42rem .42rem;
      background: linear-gradient(rgba(255,255,255,.58), rgba(255,255,255,.08) 42%, transparent),
        linear-gradient(#73c4fb, #3c8fd4 58%, #2875b8);
      box-shadow: inset 0 0 0 1px rgba(25,88,139,.55), inset 0 1px 0 rgba(255,255,255,.55);
    }

    .file-icon.doc,
    .file-icon.pdf {
      width: 3.15rem;
      height: 4rem;
      border-radius: .16rem .75rem .16rem .16rem;
      background: #fffef2;
      box-shadow: inset 0 0 0 1px rgba(0,0,0,.18), 0 .12rem .24rem rgba(0,0,0,.16);
    }

    .file-icon.pdf {
      background: #fff3f3;
    }

    .file-icon.doc::before,
    .file-icon.pdf::before {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      width: .85rem;
      height: .85rem;
      border-left: 1px solid rgba(0,0,0,.16);
      border-bottom: 1px solid rgba(0,0,0,.16);
      border-radius: 0 .7rem 0 0;
      background: #e1e1dc;
    }

    .paper-lines {
      position: absolute;
      top: 1.45rem;
      left: .68rem;
      width: 1.8rem;
      height: .13rem;
      border-radius: 1rem;
      background: #b8b8ae;
      box-shadow: 0 .45rem 0 #d7d7cc, 0 .9rem 0 #c3c3b9;
    }

    .file-icon b {
      position: absolute;
      left: 50%;
      bottom: .44rem;
      transform: translateX(-50%);
      padding: .08rem .28rem;
      border-radius: .2rem;
      background: #ce1a1a;
      color: white;
      font-size: .58rem;
      font-weight: 800;
      letter-spacing: .04em;
    }

    .preview {
      max-width: 44rem;
      margin: 0 auto;
    }

    .preview-header {
      display: flex;
      align-items: center;
      gap: .75rem;
      margin-bottom: 1rem;
    }

    .preview-header button {
      width: 2rem;
      height: 1.7rem;
      border-radius: .45rem;
      background: hsla(var(--system-color-dark-hsl), .08);
      font-size: 1.1rem;
      font-weight: 700;
    }

    .preview-header h2 {
      font-size: .95rem;
      font-weight: 650;
    }

    article {
      min-height: 21rem;
      padding: 1.35rem 1.5rem;
      border-radius: .55rem;
      background: #fffef6;
      box-shadow: 0 0 0 1px rgba(0,0,0,.09), 0 .35rem 1.5rem rgba(0,0,0,.08);
      color: #2c2c2c;
      font-family: "Courier New", Courier, monospace;
      font-size: .92rem;
      line-height: 1.65;
      white-space: pre-line;
    }

    .rtf-header {
      margin-bottom: .85rem;
      color: rgba(0,0,0,.36);
      font-size: .72rem;
    }

    .empty {
      margin-top: 4rem;
      color: hsla(var(--system-color-dark-hsl), .42);
      text-align: center;
      font-size: .9rem;
    }

    footer {
      display: grid;
      place-items: center;
      border-top: .5px solid hsla(var(--system-color-dark-hsl), .12);
      background: hsla(var(--system-color-light-hsl), .72);
      color: hsla(var(--system-color-dark-hsl), .58);
      font-size: .8rem;
    }

    #dock {
      position: absolute;
      z-index: 80;
      left: 0;
      bottom: 0;
      width: 100%;
      height: 5.2rem;
      display: flex;
      justify-content: center;
      padding: .4rem;
      pointer-events: none;
    }

    .dock-el {
      height: 100%;
      display: flex;
      align-items: flex-end;
      gap: .25rem;
      padding: .3rem;
      border-radius: 1.2rem;
      position: relative;
      background: hsla(var(--system-color-light-hsl), .4);
      box-shadow: inset 0 0 0 .2px rgba(245,245,245,.7), 0 0 0 .2px rgba(33,33,33,.7), rgba(0,0,0,.3) 2px 5px 19px 7px;
      pointer-events: auto;
    }

    .dock-el::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 20px;
      backdrop-filter: blur(10px);
      z-index: -1;
    }

    .dock-item {
      width: 3.6rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: .25rem;
      position: relative;
    }

    .dock-item img {
      width: 3.6rem;
      height: 3.6rem;
      object-fit: contain;
      transition: transform .12s ease;
    }

    .dock-item:hover img {
      transform: translateY(-.35rem) scale(1.18);
    }

    .dock-item::before {
      content: attr(aria-label);
      position: absolute;
      left: 50%;
      top: -2.15rem;
      transform: translateX(-50%);
      display: none;
      white-space: nowrap;
      padding: 0.45rem 0.7rem;
      border-radius: 0.38rem;
      background: hsla(var(--system-color-light-hsl), 0.55);
      color: #1d1d1f;
      font-size: 0.82rem;
      box-shadow: rgba(0, 0, 0, 0.3) 0 1px 7px;
      backdrop-filter: blur(8px);
    }

    .dock-item:hover::before {
      display: block;
    }

    .dock-dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #1d1d1f;
      opacity: 0;
    }

    .dock-item.open .dock-dot {
      opacity: 1;
    }

    #dialog-layer {
      position: absolute;
      inset: 0;
      z-index: 95;
      display: none;
      place-items: center;
    }

    #dialog-layer.open {
      display: grid;
    }

    .dialog {
      width: min(24rem, calc(100vw - 2rem));
      display: grid;
      grid-template-columns: 4rem 1fr;
      gap: 1rem;
      align-items: center;
      padding: 1rem;
      border-radius: 1rem;
      background: hsla(var(--system-color-light-hsl), .6);
      backdrop-filter: blur(20px);
      color: #1d1d1f;
      box-shadow: 0 2.7px 10.4px rgba(0,0,0,.124), 0 6.5px 25px rgba(0,0,0,.178), 0 12.3px 47.1px rgba(0,0,0,.22), 0 21.9px 84px rgba(0,0,0,.262), 0 40.9px 157.1px rgba(0,0,0,.316), 0 98px 376px rgba(0,0,0,.44);
    }

    .dialog img {
      width: 4rem;
      height: 4rem;
    }

    .dialog h2 {
      margin-bottom: .45rem;
      font-size: 1rem;
      font-weight: 650;
      line-height: 1.2;
    }

    .dialog p {
      color: rgba(29,29,31,.72);
      font-size: .86rem;
      line-height: 1.32;
    }

    .dialog-actions {
      grid-column: 2;
      display: flex;
      justify-content: flex-end;
    }

    .dialog-actions button {
      min-width: 5.6rem;
      height: 2rem;
      border-radius: .5rem;
      background: var(--system-color-primary);
      color: white;
      font-weight: 600;
    }

    #context-menu {
      position: fixed;
      z-index: 100;
      min-width: 16rem;
      display: none;
      padding: .5rem;
      border-radius: .5rem;
      background: hsla(var(--system-color-light-hsl), .3);
      box-shadow: rgba(0,0,0,.3) 0 0 11px;
      backdrop-filter: blur(15px);
    }

    #context-menu.open {
      display: block;
    }

    #context-menu button {
      width: 100%;
      justify-content: flex-start;
      display: flex;
      padding: .3rem .4rem;
      margin: .2rem 0;
      border-radius: .3rem;
      color: #1d1d1f;
      font-size: .9rem;
      letter-spacing: .4px;
    }

    #context-menu button:hover {
      background: var(--system-color-primary);
      color: white;
    }

    .divider {
      width: 100%;
      height: .2px;
      margin: 2px 0;
      background: rgba(29,29,31,.2);
    }

    @media (max-width: 760px) {
      .menu button:nth-of-type(n+5) {
        display: none;
      }

      .window {
        left: .75rem;
        top: 3.1rem;
        width: calc(100vw - 1.5rem);
        height: calc(100vh - 8.8rem);
      }

      .finder-main {
        grid-template-columns: 9rem 1fr;
      }

      aside {
        padding: .8rem .5rem;
      }

      .toolbar p {
        display: none;
      }
    }
  </style>
</head>
<body>
  <main id="desktop">
    <header id="topbar">
      <nav class="menu">
        <button class="apple" aria-label="Apple menu">
          <svg viewBox="0 0 24 24"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
        </button>
        <button class="app-name" data-menu="finder">Finder</button>
        <button data-menu="file">File</button>
        <button data-menu="edit">Edit</button>
        <button data-menu="view">View</button>
        <button data-menu="go">Go</button>
        <button data-menu="window">Window</button>
        <button data-menu="help">Help</button>
      </nav>
      <span class="spacer"></span>
      <div class="status">
        <button id="clock">Mon Apr 20 2:16 PM</button>
      </div>
    </header>

    <section id="icons" aria-label="Desktop items">
      <button class="desktop-icon" style="left:2.4rem;top:3rem" data-dead="Macintosh HD"><span class="icon drive" data-image-slot="macintosh-hd"></span><span class="label">Macintosh HD</span></button>
      <button class="desktop-icon" style="left:2.2rem;top:10.2rem" data-dead="Tax_Returns_2025"><span class="icon folder"></span><span class="label">Tax_Returns_2025</span></button>
      <button class="desktop-icon" style="left:10rem;top:5.4rem" data-dead="Work_Assets_Q1"><span class="icon folder"></span><span class="label">Work_Assets_Q1</span></button>
      <button class="desktop-icon" style="left:14rem;top:15.3rem" data-dead="System_Config"><span class="icon folder"></span><span class="label">System_Config</span></button>
      <button class="desktop-icon" style="right:3rem;top:4.4rem" data-dead="Client_Invoices"><span class="icon folder"></span><span class="label">Client_Invoices</span></button>
      <button class="desktop-icon" style="right:4.2rem;top:13.3rem" data-dead="printer_drivers_old"><span class="icon folder"></span><span class="label">printer_drivers_old</span></button>
      <button class="desktop-icon" style="left:43vw;top:34vh" id="gateway"><span class="icon gateway"></span><span class="label">Recovered_Files</span></button>
      <button class="desktop-icon" style="left:31vw;top:60vh" data-note="read_later.txt"><span class="icon document"></span><span class="label">read_later.txt</span></button>
      <button class="desktop-icon" style="right:3.8rem;bottom:2.2rem" data-dead="Trash"><span class="icon trash" data-image-slot="trash"></span><span class="label">Trash</span></button>
    </section>

    <section id="finder-window" class="window hidden" aria-label="Recovered Files Finder window">
      <div class="titlebar drag-handle">
        <div class="traffic">
          <button class="light red" data-close="finder-window" aria-label="Close"><svg width="7" height="7" viewBox="0 0 7 7"><path stroke="#000" stroke-width="1.2" stroke-linecap="round" fill="none" d="M1.182 5.99L5.99 1.182m0 4.95L1.182 1.323"/></svg></button>
          <button class="light yellow" id="minimize-finder" aria-label="Minimize"><svg width="6" height="1" viewBox="0 0 6 1"><path stroke="#000" stroke-width="2" stroke-linecap="round" d="M.61.703h5.8"/></svg></button>
          <button class="light green" id="zoom-finder" aria-label="Zoom"><svg viewBox="0 0 13 13"><path d="M4.871 3.553L9.37 8.098V3.553H4.871zm3.134 5.769L3.506 4.777v4.545h4.499z"/><circle cx="6.438" cy="6.438" r="6.438" fill="none"/></svg></button>
        </div>
        <h1 id="finder-title">Recovered_Files</h1>
      </div>
      <div class="toolbar drag-handle">
        <button id="back-btn" aria-label="Back">‹</button>
        <button aria-label="Forward">›</button>
        <button aria-label="Icon view">▦</button>
        <p id="path">Macintosh HD / Users / guest / Recovered_Files</p>
      </div>
      <div class="finder-main">
        <aside id="sidebar"></aside>
        <div id="filearea"></div>
      </div>
      <footer id="status">7 items, 923 MB available</footer>
    </section>

    <section id="dock">
      <div class="dock-el">
        <button class="dock-item" id="dock-finder" aria-label="Finder"><img src="./monterey-base/public/app-icons/finder/256.png" alt=""><span class="dock-dot"></span></button>
        <button class="dock-item" data-dock-error="Calendar" aria-label="Calendar"><img src="./monterey-base/public/app-icons/calendar/256.png" alt=""><span class="dock-dot"></span></button>
        <button class="dock-item" data-dock-error="Calculator" aria-label="Calculator"><img src="./monterey-base/public/app-icons/calculator/256.png" alt=""><span class="dock-dot"></span></button>
        <button class="dock-item" data-dock-error="System Preferences" aria-label="System Preferences"><img src="./monterey-base/public/app-icons/system-preferences/256.png" alt=""><span class="dock-dot"></span></button>
      </div>
    </section>

    <section id="dialog-layer">
      <div class="dialog">
        <img src="./monterey-base/public/app-icons/finder/128.png" alt="">
        <div>
          <h2 id="dialog-title">The item can't be opened.</h2>
          <p id="dialog-copy">The file may be damaged, incomplete, or from an unsupported version of macOS.</p>
        </div>
        <div class="dialog-actions"><button id="dialog-ok">OK</button></div>
      </div>
    </section>

    <menu id="context-menu">
      <button>New Folder</button>
      <div class="divider"></div>
      <button>Get Info</button>
      <button>Change Desktop Background...</button>
      <div class="divider"></div>
      <button>Use Stacks</button>
      <button>Sort By</button>
      <button>Clean Up</button>
      <button>Show View Options</button>
    </menu>

    <menu id="menubar-menu"></menu>
  </main>

  <script>
    const folders = {
      root: {
        title: "Recovered_Files",
        status: "7 items, 923 MB available",
        items: [
          { type: "doc", name: "about.me.rtf", text: "Wrong containers for true things.\n\nOfficial, cold, bureaucratic forms holding feelings that are too human for those containers.\n\nThe gap between the cold form and the warm content is where the feeling lives.\n\n- plastikfruits" },
          { type: "folder", name: "Case Files", folder: "case" },
          { type: "folder", name: "Medical Records", folder: "medical" },
          { type: "folder", name: "Legal Documents", folder: "legal" },
          { type: "folder", name: "Internal Memos", folder: "internal" },
          { type: "folder", name: "Archive", folder: "archive" },
          { type: "folder", name: "Ongoing", folder: "ongoing" }
        ]
      },
      case: {
        title: "Case Files",
        status: "2 items",
        items: [
          { type: "pdf", name: "Missing_Persons_001.pdf", label: "Missing Persons\nReport - Mother", text: "PDF render failed.\n\nRecovered text fragment:\n\nSubject last seen inside the domestic archive. Answered to several names. Usually found near the sink, the door, the end of the bed, or anywhere someone needed something and forgot to say thank you." },
          { type: "folder", name: "Ongoing", folder: "ongoing" }
        ]
      },
      medical: { title: "Medical Records", status: "1 item", items: [{ type: "doc", name: "Diagnosis_Form.rtf", label: "Diagnosis Form", text: "Primary complaint:\nfeeling like evidence in a room nobody is investigating.\n\nRecommended treatment:\nmake a container ugly enough that the truth stops trying to perform." }] },
      legal: { title: "Legal Documents", status: "2 items", items: [{ type: "doc", name: "Terms_Conditions.rtf", label: "Terms &\nConditions", text: "By continuing to live, the user agrees to recurring tenderness, delayed processing, and the occasional inability to locate the original wound." }, { type: "doc", name: "Court_Summons.rtf", label: "Court Summons", text: "You are hereby requested to appear before the part of yourself that kept every receipt." }] },
      internal: { title: "Internal Memos", status: "1 item", items: [{ type: "doc", name: "Memo_001.rtf", label: "Internal Memo\n#001", text: "Please stop labeling every emergency as administrative." }] },
      archive: { title: "Archive", status: "0 items", items: [] },
      ongoing: { title: "Ongoing", status: "0 items", items: [] }
    };

    const sidebar = [
      ["plastikfruits", [["Overview", "root"]]],
      ["Selected Work", [["Case Files", "case"], ["Medical Records", "medical"], ["Legal Documents", "legal"], ["Internal Memos", "internal"]]],
      ["Archive", [["All Experiments", "archive"], ["Ongoing", "ongoing"]]]
    ];

    const finder = document.getElementById("finder-window");
    const dockFinder = document.getElementById("dock-finder");
    const filearea = document.getElementById("filearea");
    const sidebarEl = document.getElementById("sidebar");
    const dialog = document.getElementById("dialog-layer");
    const contextMenu = document.getElementById("context-menu");
    const menubarMenu = document.getElementById("menubar-menu");
    let activeFolder = "root";
    let activeZ = 10;
    let savedFinderRect = null;

    const assetSlots = {
      "macintosh-hd": [
        "./assets/macintosh-hd.png",
        "./assets/macintosh-hd.webp",
        "./assets/hard-drive.png",
        "./assets/hard-drive.webp"
      ],
      trash: [
        "./assets/trash.png",
        "./assets/trash.webp",
        "./assets/trash-full.png",
        "./assets/trash-full.webp"
      ],
      wallpaper: [
        "./assets/wallpaper.jpg",
        "./assets/wallpaper.png",
        "./assets/wallpaper.webp"
      ]
    };

    const menus = {
      finder: [
        ["About Finder", () => showDialog("Finder", "Recovered desktop session. Some files could not be categorized.")],
        "divider",
        ["Preferences...", () => showDialog("Preferences are unavailable.", "System Settings could not be restored from this recovered session.")],
        "divider",
        ["Empty Trash...", () => showDialog("Trash can't be emptied.", "The recovered volume is read-only.")]
      ],
      file: [
        ["New Finder Window", openFinder, "⌘N"],
        ["Open", () => activeFolder === "root" ? openFinder() : renderFolder(activeFolder), "⌘O"],
        "divider",
        ["Close Window", closeFinder, "⌘W"],
        ["Get Info", () => showDialog("Recovered_Files", "Kind: Folder\nCreated: unknown\nModified: after the crash.")],
        "divider",
        ["Move to Trash", () => showDialog("The item can't be moved to Trash.", "The recovered volume is read-only.")]
      ],
      edit: [
        ["Undo", null, "⌘Z"],
        ["Redo", null, "⇧⌘Z"],
        "divider",
        ["Cut", null, "⌘X"],
        ["Copy", () => showDialog("Clipboard unavailable.", "No stable clipboard was recovered."), "⌘C"],
        ["Paste", null, "⌘V"],
        ["Select All", () => document.querySelectorAll(".file-item").forEach(item => item.classList.add("selected")), "⌘A"]
      ],
      view: [
        ["as Icons", () => showDialog("Already viewing as icons.")],
        ["as List", () => showDialog("List view is unavailable.", "Finder could not build a complete index for this folder.")],
        "divider",
        ["Use Stacks", () => showDialog("Stacks can't be enabled.", "The Desktop database is incomplete.")],
        ["Clean Up", () => showDialog("Clean Up failed.", "Some recovered items could not be categorized.")]
      ],
      go: [
        ["Recovered_Files", () => { openFinder(); renderFolder("root"); }],
        ["Case Files", () => { openFinder(); renderFolder("case"); }],
        ["Medical Records", () => { openFinder(); renderFolder("medical"); }],
        ["Legal Documents", () => { openFinder(); renderFolder("legal"); }],
        ["Internal Memos", () => { openFinder(); renderFolder("internal"); }],
        "divider",
        ["Computer", () => showDialog("Macintosh HD can't be opened.")],
        ["Trash", () => showDialog("Trash can't be opened.", "The recovered Trash index is damaged.")]
      ],
      window: [
        ["Minimize", minimizeFinder, "⌘M"],
        ["Zoom", toggleZoomFinder],
        "divider",
        ["Bring All to Front", () => finder.style.zIndex = ++activeZ]
      ],
      help: [
        ["macOS Help", () => showDialog("Help isn't available.", "The Help Viewer could not be restored.")],
        ["About plastikfruits", () => { openFinder(); renderPreview(folders.root.items[0]); }]
      ]
    };

    function setSelected(el) {
      document.querySelectorAll(".desktop-icon").forEach(item => item.classList.remove("selected"));
      if (el) el.classList.add("selected");
    }

    function showDialog(title, copy) {
      document.getElementById("dialog-title").textContent = title;
      document.getElementById("dialog-copy").textContent = copy || "The file may be damaged, incomplete, or from an unsupported version of macOS.";
      dialog.classList.add("open");
    }

    function openFinder() {
      finder.classList.remove("hidden");
      finder.style.zIndex = ++activeZ;
      dockFinder.classList.add("open");
      renderFolder(activeFolder);
    }

    function closeFinder() {
      finder.classList.add("hidden");
      finder.classList.remove("maximized");
      dockFinder.classList.remove("open");
    }

    function minimizeFinder() {
      finder.classList.add("hidden");
      dockFinder.classList.add("open");
    }

    function toggleZoomFinder() {
      if (finder.classList.contains("hidden")) openFinder();
      if (finder.classList.contains("maximized")) {
        finder.classList.remove("maximized");
        if (savedFinderRect) {
          finder.style.left = savedFinderRect.left;
          finder.style.top = savedFinderRect.top;
          finder.style.width = savedFinderRect.width;
          finder.style.height = savedFinderRect.height;
        }
        return;
      }

      const rect = finder.getBoundingClientRect();
      savedFinderRect = {
        left: finder.style.left || `${rect.left}px`,
        top: finder.style.top || `${rect.top}px`,
        width: finder.style.width || `${rect.width}px`,
        height: finder.style.height || `${rect.height}px`
      };
      finder.classList.add("maximized");
    }

    function showMenu(menuId, anchor) {
      const items = menus[menuId] || [];
      menubarMenu.innerHTML = "";
      items.forEach(item => {
        if (item === "divider") {
          const div = document.createElement("div");
          div.className = "divider";
          menubarMenu.appendChild(div);
          return;
        }
        const [label, action, shortcut] = item;
        const btn = document.createElement("button");
        btn.disabled = !action;
        btn.innerHTML = `<span>${label}</span>${shortcut ? `<kbd>${shortcut}</kbd>` : ""}`;
        if (action) btn.addEventListener("click", () => {
          hideMenu();
          action();
        });
        menubarMenu.appendChild(btn);
      });
      const rect = anchor.getBoundingClientRect();
      menubarMenu.style.left = `${rect.left}px`;
      menubarMenu.style.top = `${rect.bottom + 2}px`;
      menubarMenu.classList.add("open");
    }

    function hideMenu() {
      menubarMenu.classList.remove("open");
    }

    function renderSidebar() {
      sidebarEl.innerHTML = "";
      sidebar.forEach(([title, items]) => {
        const section = document.createElement("div");
        section.className = "sidebar-section";
        section.innerHTML = `<h2>${title}</h2>`;
        items.forEach(([label, folder]) => {
          const btn = document.createElement("button");
          btn.className = activeFolder === folder ? "active" : "";
          btn.innerHTML = `<span class="sidebar-folder"></span>${label}`;
          btn.addEventListener("click", () => renderFolder(folder));
          section.appendChild(btn);
        });
        sidebarEl.appendChild(section);
      });
    }

    function renderFolder(id) {
      activeFolder = id;
      const folder = folders[id];
      document.getElementById("finder-title").textContent = folder.title;
      document.getElementById("path").textContent = `Macintosh HD / Users / guest / ${folder.title}`;
      document.getElementById("status").textContent = folder.status;
      renderSidebar();

      if (!folder.items.length) {
        filearea.innerHTML = `<p class="empty">This folder is empty.</p>`;
        return;
      }

      filearea.innerHTML = `<div class="file-grid"></div>`;
      const grid = filearea.querySelector(".file-grid");
      folder.items.forEach(item => {
        const btn = document.createElement("button");
        btn.className = "file-item";
        const icon = item.type === "folder"
          ? `<span class="file-icon folder"></span>`
          : `<span class="file-icon ${item.type}"><span class="paper-lines"></span>${item.type === "pdf" ? "<b>PDF</b>" : ""}</span>`;
        btn.innerHTML = `${icon}<span class="file-label">${item.label || item.name}</span>`;
        btn.addEventListener("click", () => item.folder ? renderFolder(item.folder) : renderPreview(item));
        grid.appendChild(btn);
      });
    }

    function renderPreview(item) {
      filearea.innerHTML = `
        <section class="preview">
          <div class="preview-header">
            <button id="preview-back">‹</button>
            <h2>${item.name}</h2>
          </div>
          <article>
            <p class="rtf-header">${item.type === "pdf" ? "%PDF-1.3 - recovered text" : "{\\rtf1 - plaintext render - last modified: unknown}"}</p>${item.text || "No preview available."}
          </article>
        </section>`;
      document.getElementById("preview-back").addEventListener("click", () => renderFolder(activeFolder));
    }

    document.querySelectorAll(".desktop-icon").forEach(icon => {
      icon.addEventListener("click", event => {
        event.stopPropagation();
        setSelected(icon);
        if (icon.id === "gateway") openFinder();
        else if (icon.dataset.note) showDialog(`"${icon.dataset.note}" can't be opened.`, "TextEdit quit unexpectedly while recovering this document.");
        else showDialog(`"${icon.dataset.dead}" can't be opened.`);
      });
    });

    dockFinder.addEventListener("click", openFinder);
    document.querySelectorAll("[data-dock-error]").forEach(btn => btn.addEventListener("click", () => showDialog(`${btn.dataset.dockError} is not available.`, "The application could not be restored from this recovered session.")));
    document.querySelector("[data-close='finder-window']").addEventListener("click", closeFinder);
    document.getElementById("minimize-finder").addEventListener("click", minimizeFinder);
    document.getElementById("zoom-finder").addEventListener("click", toggleZoomFinder);
    document.getElementById("dialog-ok").addEventListener("click", () => dialog.classList.remove("open"));
    dialog.addEventListener("click", event => { if (event.target === dialog) dialog.classList.remove("open"); });

    document.getElementById("desktop").addEventListener("click", event => {
      if (event.target.id === "desktop" || event.target.id === "icons") setSelected(null);
      contextMenu.classList.remove("open");
      if (!event.target.closest("#menubar-menu") && !event.target.closest("[data-menu]")) hideMenu();
    });

    document.querySelectorAll("[data-menu]").forEach(button => {
      button.addEventListener("click", event => {
        event.stopPropagation();
        const isOpen = menubarMenu.classList.contains("open");
        const sameMenu = menubarMenu.dataset.active === button.dataset.menu;
        if (isOpen && sameMenu) {
          hideMenu();
          return;
        }
        menubarMenu.dataset.active = button.dataset.menu;
        showMenu(button.dataset.menu, button);
      });
      button.addEventListener("mouseenter", () => {
        if (menubarMenu.classList.contains("open")) {
          menubarMenu.dataset.active = button.dataset.menu;
          showMenu(button.dataset.menu, button);
        }
      });
    });

    document.addEventListener("contextmenu", event => {
      event.preventDefault();
      const x = Math.min(event.clientX, window.innerWidth - 270);
      const y = Math.min(event.clientY, window.innerHeight - 310);
      contextMenu.style.left = `${x}px`;
      contextMenu.style.top = `${y}px`;
      contextMenu.classList.add("open");
    });

    document.querySelectorAll("#context-menu button").forEach(btn => btn.addEventListener("click", () => {
      contextMenu.classList.remove("open");
      showDialog(`${btn.textContent} is unavailable.`, "Finder cannot complete the operation because the recovered volume is read-only.");
    }));

    document.getElementById("back-btn").addEventListener("click", () => renderFolder("root"));

    function makeDraggable(win) {
      const handles = win.querySelectorAll(".drag-handle");
      let startX = 0, startY = 0, baseX = 0, baseY = 0, dragging = false;
      handles.forEach(handle => {
        handle.addEventListener("pointerdown", event => {
          if (event.target.closest("button")) return;
          if (win.classList.contains("maximized")) return;
          dragging = true;
          win.style.zIndex = ++activeZ;
          const rect = win.getBoundingClientRect();
          startX = event.clientX;
          startY = event.clientY;
          baseX = rect.left;
          baseY = rect.top;
          handle.setPointerCapture(event.pointerId);
        });
        handle.addEventListener("pointermove", event => {
          if (!dragging) return;
          win.style.left = `${baseX + event.clientX - startX}px`;
          win.style.top = `${Math.max(28, baseY + event.clientY - startY)}px`;
        });
        handle.addEventListener("pointerup", () => dragging = false);
      });
    }

    makeDraggable(finder);
    renderFolder("root");

    async function applyOptionalAsset(slot, paths) {
      for (const path of paths) {
        try {
          const response = await fetch(path, { method: "HEAD" });
          if (!response.ok) continue;

          if (slot === "wallpaper") {
            document.getElementById("desktop").style.backgroundImage = `url("${path}")`;
            return;
          }

          document.querySelectorAll(`[data-image-slot="${slot}"]`).forEach(icon => {
            icon.classList.add("image-icon");
            icon.style.backgroundImage = `url("${path}")`;
          });
          return;
        } catch (error) {
          // Missing optional asset, try the next name.
        }
      }
    }

    Object.entries(assetSlots).forEach(([slot, paths]) => applyOptionalAsset(slot, paths));
  </script>
</body>
